# Conexão PostgreSQL (obrigatória)
# No Railway esta variável é injetada automaticamente pela vinculação do
# serviço PostgreSQL (não é preciso cadastrá-la manualmente); em desenvolvimento,
# preencha manualmente.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/finfam?schema=public"

# PostgreSQL dedicado aos testes de integração (opcional; nunca SQLite).
# Sem esta variável, `npm run test:integration` falha com mensagem explícita.
# TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/finfam_test?schema=public"

# Credenciais de acesso da família (autenticação simples)
FINFAM_USER="familia"
FINFAM_PASS="troque-esta-senha"

# Segredo para assinar o cookie de sessão (use um valor longo e aleatório)
FINFAM_SESSION_SECRET="troque-por-um-segredo-longo-e-aleatorio"

# Ambiente
NODE_ENV="development"

# No Railway (ver seção "Deploy no Railway" do README): além de DATABASE_URL,
# o próprio Railway injeta PORT e, no deploy, NODE_ENV=production.
