// FinFam — modelo de dados
// Valores monetários são armazenados em centavos (Int) para evitar
// imprecisão de ponto flutuante.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PaymentMethod {
  CASH
  DEBIT
  PIX
  CREDIT
}

/// Classificação do item da lista de compras: consumível básico ou desejo.
enum ShoppingItemKind {
  ESSENCIAL
  DESEJAVEL
}

/// Forma de medir o consumo do ciclo na Home (história #380): pela renda
/// (`INCOME`, default/comportamento atual) ou pelo orçamento que sobra depois
/// dos gastos fixos (`VARIABLE_BUDGET`).
enum ConsumptionMode {
  INCOME
  VARIABLE_BUDGET
}

/// Entrada fixa recorrente (ex.: salário).
model Income {
  id          String   @id @default(cuid())
  name        String
  amountCents Int
  receiveDay  Int      @default(1)
  active      Boolean  @default(true)
  startMonth  String? // YYYY-MM
  endMonth    String? // YYYY-MM
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("incomes")
}

/// Entrada avulsa (não recorrente): venda de algo, saldo que sobrou no mês etc.
/// Conta como renda do mês da `date` e entra no orçamento do ciclo.
model VariableIncome {
  id          String   @id @default(cuid())
  description String
  amountCents Int
  date        DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
  @@map("variable_incomes")
}

/// Saída fixa recorrente (ex.: aluguel, luz, internet).
model FixedExpense {
  id          String   @id @default(cuid())
  name        String
  amountCents Int
  dueDay      Int      @default(1)
  category    String?
  active      Boolean  @default(true)
  startMonth  String? // YYYY-MM
  endMonth    String? // YYYY-MM
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("fixed_expenses")
}

/// Cartão de crédito.
model CreditCard {
  id         String         @id @default(cuid())
  name       String
  limitCents Int?
  closingDay Int
  dueDay     Int
  active     Boolean        @default(true)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  purchases  CardPurchase[]
  expenses   VariableExpense[]

  @@map("credit_cards")
}

/// Gasto avulso (pode ter sido pago no cartão).
model VariableExpense {
  id            String        @id @default(cuid())
  description   String
  amountCents   Int
  date          DateTime
  category      String?
  paymentMethod PaymentMethod @default(CASH)
  paid          Boolean       @default(false)
  creditCardId  String?
  creditCard    CreditCard?   @relation(fields: [creditCardId], references: [id])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([date])
  @@map("variable_expenses")
}

/// Compra no cartão de crédito (pode ser parcelada).
model CardPurchase {
  id                String     @id @default(cuid())
  cardId            String
  card              CreditCard @relation(fields: [cardId], references: [id])
  description       String
  amountCents       Int
  purchaseDate      DateTime
  category          String?
  installmentNumber Int        @default(1)
  installmentsTotal Int        @default(1)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([purchaseDate])
  @@map("card_purchases")
}

/// Cache mensal usado para o feedback comparativo (ex.: "melhores que os
/// últimos 4 meses"). Pode ser recalculado a partir das transações.
model MonthlySnapshot {
  id                   String   @id @default(cuid())
  monthKey             String   @unique // YYYY-MM
  incomeCents          Int
  /// Entradas fixas vigentes no mês (separadas das avulsas na task #255).
  fixedIncomeCents     Int      @default(0)
  /// Entradas avulsas (venda/saldo) do mês.
  variableIncomeCents  Int      @default(0)
  fixedExpensesCents   Int
  variableExpensesCents Int
  cardExpensesCents    Int
  consumedCents        Int
  consumedPercent      Float
  /// Consumo disponível do mês (`entradas − gastos fixos`, nunca negativo).
  consumptionAvailableCents Int  @default(0)
  /// Média diária do consumo disponível no mês calendário.
  dailyAverageCents    Int      @default(0)
  /// Dias do mês calendário usado no cálculo da média diária.
  daysInMonth          Int      @default(0)
  /// Consumo variável por dia (avulsos + cartão do próprio mês), 1-based.
  variableDailyCents    Int[]   @default([])
  /// Obrigações por dia (fixas + parcelas de cartão de meses anteriores).
  obligationDailyCents  Int[]   @default([])
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  categories MonthlyCategorySnapshot[]

  @@map("monthly_snapshots")
}

/// Gasto de um mês fechado por categoria, gerado por `buildCategoryBreakdown`.
/// Invariante: a soma de `amountCents` de um `monthKey` iguala o `consumedCents`
/// do `MonthlySnapshot` correspondente.
model MonthlyCategorySnapshot {
  id            String   @id @default(cuid())
  monthKey      String // YYYY-MM
  /// Chave normalizada da categoria (`categoryKey`); `""` = sem categoria.
  categoryKey   String
  /// Rótulo exibido (`NO_CATEGORY_LABEL` quando vazio/ausente).
  categoryLabel String
  amountCents   Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  monthlySnapshot MonthlySnapshot @relation(fields: [monthKey], references: [monthKey], onDelete: Cascade)

  @@unique([monthKey, categoryKey])
  @@index([monthKey])
  @@map("monthly_category_snapshots")
}

/// Configuração global da família. Linha singleton (id fixo "singleton");
/// `cycleStartDay` é o dia do mês que marca o início do ciclo financeiro
/// (default 1 = mês calendário).
model AppSettings {
  id               String          @id @default("singleton")
  cycleStartDay    Int             @default(1)
  savingsGoalCents Int?
  consumptionMode  ConsumptionMode @default(INCOME)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@map("app_settings")
}

/// Item da lista de compras da família (história #376). O item ativo
/// (`purchased = false`) entra na lista e no planejamento do dashboard; marcar
/// como comprado apenas o remove da lista ativa, preservando o histórico — a
/// compra não gera gasto automaticamente.
model ShoppingItem {
  id                      String           @id @default(cuid())
  name                    String
  kind                    ShoppingItemKind
  category                String?
  quantity                Int              @default(1)
  /// Preço unitário estimado em centavos; `null` = "sem preço".
  estimatedUnitPriceCents Int?
  /// Origem do preço pesquisado (ex.: `google_shopping`).
  priceSource             String?
  priceSampleCount        Int              @default(0)
  priceFetchedAt          DateTime?
  purchased               Boolean          @default(false)
  purchasedAt             DateTime?
  addedOn                 String // YYYY-MM-DD no fuso da família
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  @@index([purchased])
  @@index([addedOn])
  @@map("shopping_items")
}

/// Saldo guardado confirmado pela família em um mês (`YYYY-MM`). A sobra do
/// período é estimada pelo fluxo; este valor é a fonte de verdade da reserva e
/// permite reconciliar "quanto deveria ter sobrado" x "quanto a reserva subiu".
model ReserveSnapshot {
  id          String   @id @default(cuid())
  monthKey    String   @unique // YYYY-MM
  amountCents Int
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("reserve_snapshots")
}

/// Avaliação de um mês fechado gerada por IA, cacheada por `monthKey` para não
/// repetir a chamada à DeepSeek. `summary` é o texto exibido no dashboard.
model MonthlyReview {
  id        String   @id @default(cuid())
  monthKey  String   @unique // YYYY-MM
  summary   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("monthly_reviews")
}
